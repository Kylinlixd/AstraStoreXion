# Safe single-node defaults. Copy to /etc/astrastore-xion.env with mode 0600.
XION_LISTEN_ADDR=127.0.0.1:8081
XION_DATA_DIR=/var/lib/astrastore-xion
# 单文件默认上限：1 GiB
XION_MAX_UPLOAD_BYTES=1073741824
# 达到数据目录所在文件系统使用率后自动暂停新上传；删除/读取不受影响。
XION_STORAGE_PAUSE_AT_PERCENT=90
# 可选：每个 metadata.owner 的逻辑配额（字节）；0 表示关闭。
# XION_OWNER_QUOTA_BYTES=10737418240

# Optional asynchronous primary-to-replica queue. Leave XION_REPLICA_URL empty
# for the default single-node deployment. The replica must use its own token.
# XION_REPLICA_URL=http://127.0.0.1:18081
# XION_REPLICA_TOKEN=replace-with-replica-service-token
# XION_REPLICATION_DIR=/var/lib/astrastore-xion/replication
# XION_REPLICATION_MAX_ATTEMPTS=10

# Add XION_SERVICE_TOKEN on the server with a freshly generated 32-byte value.
# Never commit, print, or expose the real token to the browser.
